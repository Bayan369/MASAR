# Public browser configuration only. Never place secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:8000

# Supabase public browser settings only. Never use secret/service_role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Ask MASAR uses the Backend API by default, including local development.
# VITE_ASSISTANT_MODE=offline # explicit legacy offline showcase only; never live AI.
# Vercel server environment ONLY (never VITE_): MASAR_DEMO_BACKEND_URL
# Set to the existing HTTPS Backend origin, with no path or credentials.

# Local Vite server only (not browser configuration): MASAR_LOCAL_API_ORIGIN=http://127.0.0.1:8000

# /assistant: llama uses the real Backend; offline is the explicit local diagnostic engine.
VITE_ASSISTANT_MODE=llama
# Vite development proxy only; loaded from this directory's .env files.
MASAR_LOCAL_API_ORIGIN=http://127.0.0.1:8000
# Vercel API functions additionally require MASAR_DEMO_BACKEND_URL at runtime.
# Set it in the hosting environment to your actual HTTPS Backend origin, without /api/v1.
# It is server-only (no VITE_ prefix) and is NOT a Cloudflare credential.

# Render Static Site: set VITE_API_BASE_URL to the actual HTTPS Backend origin.
# No /api suffix. Chat and packaged source links then use /api/v1/demo directly.
# Leave it unset only when intentionally retaining the local/Vercel proxy path.
# Public Demo needs no VITE_SUPABASE_* variables and no MASAR_DEMO_BACKEND_URL.
