MASAR_APP_NAME=MASAR
MASAR_ENVIRONMENT=development
MASAR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server-only Cloudflare settings. Never put API tokens in VITE_ variables.
MASAR_CLOUDFLARE_ACCOUNT_ID=
MASAR_CLOUDFLARE_API_TOKEN=
MASAR_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Set true ONLY after confirming the account uses Workers Free (not Paid).
MASAR_CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# Supabase server settings. Secret key is ONLY for trusted server/worker operations.
MASAR_SUPABASE_URL=
MASAR_SUPABASE_PUBLISHABLE_KEY=
MASAR_SUPABASE_SERVICE_KEY=
MASAR_AUTH_REDIRECT_URL=http://localhost:5173/reset-password
# hybrid uses BGE-M3 vectors and lexical evidence. lexical is an explicit diagnostic mode.
MASAR_RETRIEVAL_MODE=hybrid
MASAR_DEMO_ENABLED=false
# Shared chat+embedding call count PER PROCESS; not a billing guarantee.
# Workers Free must remain active. Review provider failures before manual restart.
MASAR_AI_CALL_BUDGET=20

# Public demo ONLY: explicitly set MASAR_ENVIRONMENT=demo and MASAR_DEMO_ENABLED=true.
# Requires Cloudflare credentials, confirmed Free plan, and exact HTTPS frontend origins.
# Existing production validation is unchanged. Never set CORS to wildcard.
MASAR_DEMO_REQUESTS_PER_MINUTE=6
MASAR_DEMO_MAX_CONCURRENT=1
# 0 disables the overall request limit; AI_CALL_BUDGET still applies.
MASAR_DEMO_TOTAL_REQUESTS=100
MASAR_DEMO_MAX_IPS=10000
MASAR_MAX_UPLOAD_BYTES=5242880
# Hosting process variables (read by scripts/start_server.py, not Settings):
# PORT=8000
# No forwarded IP headers trusted by default; use verified proxy IP/CIDR allowlist only.
# MASAR_TRUSTED_PROXY_IPS=

# Demo now honors the existing retrieval mode: hybrid (default) or explicit lexical diagnostic.
# Hybrid uses existing Workers Free Llama + multilingual BGE-M3; no new subscription.
MASAR_SEMANTIC_MIN_SIMILARITY=0.35
MASAR_RERANK_MIN_SCORE=0.6
# Cold corpus: 2 embedding calls for 12 passages. Warm question: rewrite + embed + rerank + answer.
# Existing MASAR_AI_CALL_BUDGET remains enforced across all these calls (default 20).

# Local /api/v1/demo/ask requires MASAR_DEMO_ENABLED=true explicitly.
# Keep exactly one active MASAR_ENVIRONMENT assignment; development is for local HTTP.
# Hosted demo uses environment=demo, configured AI and explicit HTTPS CORS origins.
# start_server reads PORT and MASAR_TRUSTED_PROXY_IPS from PROCESS environment,
# not this Pydantic .env file. Set them in the shell/hosting platform if needed.
# Default PORT is 8000; no proxy IPs are trusted by default. Never use a wildcard.
