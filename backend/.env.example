MASAR_APP_NAME=MASAR
MASAR_ENVIRONMENT=development
MASAR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server-only Cloudflare settings. Never put API tokens in VITE_ variables.
MASAR_CLOUDFLARE_ACCOUNT_ID=
MASAR_CLOUDFLARE_API_TOKEN=
MASAR_CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Set true ONLY after confirming the account uses Workers Free (not Paid).
MASAR_CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# Supabase server settings. Secret key is ONLY for trusted server/worker operations.
MASAR_SUPABASE_URL=
MASAR_SUPABASE_PUBLISHABLE_KEY=
MASAR_SUPABASE_SERVICE_KEY=
MASAR_AUTH_REDIRECT_URL=http://localhost:5173/reset-password
# hybrid uses BGE-M3 vectors and lexical evidence. lexical is an explicit diagnostic mode.
MASAR_RETRIEVAL_MODE=hybrid
MASAR_DEMO_ENABLED=false
# Shared chat+embedding call count PER PROCESS; not a billing guarantee.
# Workers Free must remain active. Review provider failures before manual restart.
MASAR_AI_CALL_BUDGET=20
